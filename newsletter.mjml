<mjml>
  <mj-head>
    <mj-title>Upgrade Alert: Smarter Workflows, Global Scale &amp; Next-Gen AI in Ezovion HIMS</mj-title>
    <mj-preview>Modern hospitals thrive when bedside care and back-office governance move in perfect sync.</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#2d2d2d" font-size="15px" line-height="23px" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      a { color: #621742; }
      .article-link a { color: #2d2d2d !important; text-decoration: none; }
      .footer-link a { color: #fce8fa !important; }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .mobile-pad > table > tbody > tr > td { padding-left: 20px !important; padding-right: 20px !important; }
        .mobile-center div { text-align: center !important; }
        .mobile-center img { margin-left: auto !important; margin-right: auto !important; }
        .mobile-title div { font-size: 29px !important; line-height: 35px !important; }
        .mobile-gap > table > tbody > tr > td { padding-bottom: 18px !important; }
        .pair-cell { display: block !important; width: 100% !important; }
        .pair-cell-first { border-bottom: 12px solid #fce8fa !important; }
